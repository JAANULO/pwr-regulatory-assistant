# .editorconfig – Asystent Regulaminowy PWr v2
# Dokumentacja: https://editorconfig.org
root = true

# ── Domyślne reguły dla wszystkich plików ──────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true

# ── Python ─────────────────────────────────────────────────────
[*.py]
indent_style = space
indent_size  = 4
max_line_length = 100

# ── HTML (szablony Jinja2) ──────────────────────────────────────
[*.html]
indent_style = space
indent_size  = 2

# ── JavaScript (osadzony w HTML) ────────────────────────────────
[*.js]
indent_style = space
indent_size  = 2

# ── JSON (bazy wiedzy, dane) ────────────────────────────────────
[*.json]
indent_style = space
indent_size  = 2

# ── Pliki konfiguracyjne ────────────────────────────────────────
[*.{yml,yaml,toml,ini,cfg,conf}]
indent_style = space
indent_size  = 2

# ── Markdown (CHANGELOG, PLAN) ──────────────────────────────────
[*.md]
indent_style             = space
indent_size              = 2
trim_trailing_whitespace = false

# ── Pliki wymagań pip ───────────────────────────────────────────
[requirements*.txt]
indent_style             = space
insert_final_newline     = true
trim_trailing_whitespace = true
